# ==========================================================
# Nexra — Production-Grade Security & Public Repository .gitignore
# ==========================================================

# 1. Environment & Secrets (Crucial for Public Repo)
.env*
!.env.example
*.pem
*.key
*.pub
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
service-account*.json
credentials.json
client_secret*.json
google-services.json

# 2. Local Database & Storage Files
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite

# 3. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 4. Next.js, Turbopack & Web Builds
/.next/
/out/
/build
/dist
.vercel
*.tsbuildinfo
next-env.d.ts

# 5. Android & Mobile Builds, SDK Configs & Signing Keys
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/captures/
android/app/google-services.json
android/app/*.jks
android/app/*.keystore
android/app/release/
*.apk
*.aab
*.dex
*.class
bin/
gen/

# 6. IDEs, Editors & Workspaces
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
*.bak

# 7. OS Metadata & Cache
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# 8. Testing & Logs
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 9. Non-public internal prompt & planning docs (Keep only public README & AGENTS)
*.md
!README.md
!AGENTS.md
